<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><span class="debug-var">VARIABLE_TITLE</span></title>
  <style>
    @page {
      size: A4;
      margin: 20mm;
    }

    .debug-var {
      color: red;
      font-weight: bold;
    }

    :root {
      --ink: #1f2937;
      --ink-soft: #4b5563;
      --line: #d1d5db;
      --line-strong: #9ca3af;
      --bg-soft: #f8fafc;
      --brand: #0f3d5e;
      --brand-soft: #e7eef4;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: Arial, sans-serif;
      font-size: 12px;
      line-height: 1.5;
      background: #ffffff;
      page-break-inside: avoid;
    }

    .document {
      max-width: 180mm;
      margin: 0 auto;
    }

    .page-header {
      border: 1px solid var(--line-strong);
      background: var(--bg-soft);
      margin-bottom: 18px;
      padding: 10px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    <!DOCTYPE html>
    <html lang="fr">
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="X-UA-Compatible" content="IE=edge" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{{metadata.title}}</title>
      <style>
        html {
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        * {
          box-sizing: border-box;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        @page {
          size: A4;
          margin: 18mm 14mm;
        }

        :root {
          --ink: #37352f;
          --muted: rgba(55, 53, 47, 0.62);
          --line: rgba(55, 53, 47, 0.14);
          --soft: #f7f6f3;
          --callout: #f3f7fc;
          --accent: #1f4e79;
          --debug: #b91c1c;
          --debug-bg: #fff1f2;
          --debug-line: #fecdd3;
        }

        body {
          margin: 0;
          color: var(--ink);
          font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
          line-height: 1.5;
          white-space: normal;
          font-size: 13px;
          background: #fff;
        }

        article.page {
          max-width: 900px;
          margin: 0 auto;
        }

        .page-header-icon {
          font-size: 2.2rem;
          margin-bottom: 0.4rem;
        }

        .page-title {
          font-size: 2rem;
          font-weight: 700;
          margin: 0 0 0.3em;
          color: var(--accent);
          letter-spacing: -0.01em;
          line-height: 1.2;
        }

        .subtitle {
          color: var(--muted);
          margin: 0;
        }

        .debug-var {
          color: var(--debug);
          font-weight: 700;
          background: var(--debug-bg);
          border: 1px solid var(--debug-line);
          border-radius: 4px;
          padding: 1px 4px;
          display: inline-block;
          line-height: 1.35;
        }

        h1,
        h2,
        h3,
        h4,
        h5 {
          letter-spacing: -0.01em;
          line-height: 1.25;
          font-weight: 650;
          margin-bottom: 0.35rem;
          page-break-after: avoid;
        }

        h2 {
          font-size: 1.45rem;
          margin-top: 1.5rem;
          color: var(--accent);
          border-bottom: 1px solid var(--line);
          padding-bottom: 0.24rem;
        }

        h3 {
          font-size: 1.18rem;
          margin-top: 1.2rem;
        }

        h4,
        h5 {
          font-size: 1rem;
          margin-top: 1rem;
        }

        p {
          margin: 0.55rem 0;
        }

        ul {
          margin: 0.5rem 0;
          padding-left: 1.5rem;
        }

        li {
          margin: 0.22rem 0;
        }

        .callout {
          border-radius: 10px;
          border: 1px solid rgba(31, 78, 121, 0.18);
          background: var(--callout);
          padding: 0.9rem 1rem;
          margin: 0.8rem 0;
          page-break-inside: avoid;
        }

        .section {
          page-break-inside: avoid;
        }

        table {
          width: 100%;
          border-collapse: collapse;
          margin: 0.75rem 0 1rem;
          table-layout: fixed;
          page-break-inside: avoid;
        }

        thead {
          display: table-header-group;
        }

        tfoot {
          display: table-footer-group;
        }

        tr {
          page-break-inside: avoid;
        }

        th,
        td {
          border: 1px solid var(--line);
          text-align: left;
          vertical-align: top;
          padding: 0.4rem 0.5rem;
          font-size: 0.88rem;
          word-break: break-word;
          overflow-wrap: anywhere;
          white-space: normal;
        }

        th {
          background: var(--soft);
          color: var(--muted);
          font-weight: 650;
        }

        .steps-table col.col-step {
          width: 8%;
        }

        .steps-table col.col-action {
          width: 46%;
        }

        .steps-table col.col-expected {
          width: 46%;
        }

        .suite {
          margin-top: 1rem;
          padding-left: 0.9rem;
          border-left: 2px solid var(--line);
          page-break-before: auto;
          page-break-inside: avoid;
        }

        .suite + .suite {
          page-break-before: always;
        }

        .suite-title {
          margin: 0 0 0.3rem;
          color: #1f3f63;
        }

        .test-case {
          margin: 0.7rem 0 0.9rem;
          padding: 0.7rem 0.8rem;
          border: 1px solid var(--line);
          border-radius: 6px;
          page-break-inside: avoid;
        }

        .test-case-title {
          margin: 0;
          color: #15344f;
          font-size: 0.96rem;
        }

        .summary {
          color: #4e4b45;
          margin-top: 0.35rem;
        }

        .small {
          font-size: 0.85rem;
          color: var(--muted);
        }

        .footer-note {
          margin-top: 1rem;
          border-top: 1px solid var(--line);
          padding-top: 0.5rem;
          display: flex;
          justify-content: space-between;
          gap: 0.8rem;
          font-size: 0.8rem;
          color: var(--muted);
        }
      </style>
    </head>
    <body>
      <article class="page sans">
        <header>
          <div class="page-header-icon">🧪</div>
          <h1 class="page-title"><span class="debug-var">{{metadata.title}}</span></h1>
          <p class="subtitle">Cahier de recette</p>
          <p class="small">Document de reference : <span class="debug-var">{{template.id}}</span></p>
        </header>

        <div class="page-body">
          <section class="section">
            <h2>Propriete et controle du document</h2>

            <h3>Propriete</h3>
            <div class="callout">
              Ce document est confidentiel et a ete prepare specialement pour <span class="debug-var">{{metadata.clientName}}</span>.
              Les informations qu'il contient ne doivent pas etre transmises a des tiers sans autorisation.
            </div>

            <h3>Controle du document</h3>
            <ul>
              <li>Titre : <span class="debug-var">{{metadata.title}}</span></li>
              <li>Nom de fichier : <span class="debug-var">cahier-recette-{{project.id}}-{{metadata.version}}.pdf</span></li>
              <li>Type de fichier : <span class="debug-var">Cahier de recette</span></li>
              <li>References : <span class="debug-var">{{template.name}}</span></li>
            </ul>

            <h3>Revisions du document</h3>
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Version</th>
                  <th>Auteur</th>
                  <th>Statut du document</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="debug-var">{{metadata.date}}</span></td>
                  <td><span class="debug-var">{{metadata.version}}</span></td>
                  <td><span class="debug-var">{{metadata.author}}</span></td>
                  <td><span class="debug-var">Version courante</span></td>
                </tr>
              </tbody>
            </table>

            {{#if template.showApprovals}}
            <h3>Approbations</h3>
            <table>
              <thead>
                <tr>
                  <th>Nom</th>
                  <th>Role</th>
                  <th>Signature</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                {{#each approvals}}
                <tr>
                  <td><span class="debug-var">{{name}}</span></td>
                  <td><span class="debug-var">{{role}}</span></td>
                  <td><span class="debug-var">Signature: __________________</span></td>
                  <td><span class="debug-var">{{date}}</span></td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            {{/if}}
          </section>

          {{#if template.showContext}}
          <section class="section">
            <h2>Description du document</h2>
            <p><span class="debug-var">{{context.description}}</span></p>

            <h2>Objectif du document</h2>
            <p><span class="debug-var">{{context.objective}}</span></p>
          </section>
          {{/if}}

          <section class="section">
            <h2>Informations projet</h2>
            <ul>
              <li>Client : <span class="debug-var">{{metadata.clientName}}</span></li>
              <li>Projet / Produit : <span class="debug-var">{{project.name}}</span></li>
              <li>Version / Sprint : <span class="debug-var">{{metadata.version}}</span></li>
              <li>Perimetre fonctionnel : <span class="debug-var">Suites et cas de test documentes</span></li>
              <li>Environnement de test : <span class="debug-var">QA</span></li>
              <li>Equipe QA : <span class="debug-var">{{project.owner}}</span></li>
            </ul>
          </section>

          <section class="section">
            <h2>Suites de test</h2>

            {{#*inline "suiteNode"}}
            <div class="suite suite-depth-{{depth}}">
              {{{suiteHeading depth name}}}

              {{#each testCases}}
              <article class="test-case">
                <h5 class="test-case-title">Cas de test <span class="debug-var">{{code}}</span> : <span class="debug-var">{{name}}</span></h5>
                <p class="summary"><strong>Resume :</strong> <span class="debug-var">{{summary}}</span></p>

                {{#if @root.template.showPreconditions}}
                <p><strong>Preconditions :</strong></p>
                <ul>
                  {{#each preconditions}}
                  <li><span class="debug-var">{{content}}</span></li>
                  {{/each}}
                </ul>
                {{/if}}

                {{#if @root.template.showSteps}}
                <table class="steps-table">
                  <colgroup>
                    <col class="col-step" />
                    <col class="col-action" />
                    <col class="col-expected" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Actions a realiser</th>
                      <th>Resultats attendus</th>
                    </tr>
                  </thead>
                  <tbody>
                    {{#each steps}}
                    <tr>
                      <td><span class="debug-var">{{order}}</span></td>
                      <td><span class="debug-var">{{action}}</span></td>
                      <td><span class="debug-var">{{expectedResult}}</span></td>
                    </tr>
                    {{/each}}
                  </tbody>
                </table>
                {{/if}}
              </article>
              {{/each}}

              {{#each children}}
                {{> suiteNode}}
              {{/each}}
            </div>
            {{/inline}}

            {{#each suites}}
              {{> suiteNode}}
            {{/each}}
          </section>

          <section class="section">
            <h2>Synthese de recette (optionnel)</h2>
            <table>
              <thead>
                <tr>
                  <th>Indicateur</th>
                  <th>Valeur</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="debug-var">Nombre total de cas</span></td>
                  <td><span class="debug-var">{{metadata.version}}</span></td>
                </tr>
                <tr>
                  <td><span class="debug-var">Anomalies ouvertes</span></td>
                  <td><span class="debug-var">Voir suivi QA</span></td>
                </tr>
              </tbody>
            </table>
          </section>

          <section class="section">
            <h2>Conclusion (optionnel)</h2>
            <p><span class="debug-var">Decision de recette a confirmer lors du comite de validation.</span></p>
          </section>
        </div>

        <footer class="footer-note">
          <span><span class="debug-var">{{template.footer}}</span></span>
        </footer>
      </article>
    </body>
    </html>
