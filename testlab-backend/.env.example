# ============================================================================
# TestLab Backend Environment Configuration Example
# ============================================================================
# Copy this file to .env and update the values for your environment.
# REQUIRED variables must be set before running the application.
# OPTIONAL variables have defaults if not specified.
# ============================================================================

# ============================================================================
# Core Application Settings
# ============================================================================

# Environment type: local, development, staging, or production
NODE_ENV=local

# Server port (optional; defaults to 5000 if not set)
PORT=3000

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?schema=public
# Example: postgresql://postgres:password@localhost:5432/testlab_db?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/testlab_db?schema=public

# ============================================================================
# Puppeteer/Browser Configuration (OPTIONAL)
# ============================================================================
# These variables control how Puppeteer/PDF generation finds the browser executable.
# If ALL are empty, Puppeteer will auto-detect the browser (Chromium or Chrome).
# Leave empty to use auto-detection, or specify explicit path to browser executable.
#
# Resolution priority (checked in order):
#   1. PUPPETEER_EXECUTABLE_PATH
#   2. CHROME_PATH
#   3. CHROME_EXECUTABLE_PATH
#   4. Puppeteer's built-in detection (system Chrome/Chromium)
#
# To find your browser path:
#   - Windows:  where chrome  OR  where chromium
#   - macOS:    which 'Google Chrome'
#   - Linux:    which google-chrome  OR  which chromium

# Explicit path to Chrome or Chromium executable (optional; checked first)
# Example Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# Example macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Example Linux:   /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=

# Alternative browser path variable (optional; checked second)
CHROME_PATH=

# Alternative browser path variable (optional; checked third)
CHROME_EXECUTABLE_PATH=

# ============================================================================
# Third-Party Services (OPTIONAL)
# ============================================================================
# Cloudinary credentials for image upload and storage functionality.
# Leave empty if image uploads are not used.

# Cloudinary cloud name
CLOUDINARY_CLOUD_NAME=dqeq2bwzk

# Cloudinary API key
CLOUDINARY_API_KEY=895179812575174

# Cloudinary API secret
CLOUDINARY_API_SECRET=DBoyrRdusTC7as3D4LEgBhv1fEk
