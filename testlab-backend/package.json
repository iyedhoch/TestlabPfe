{
  "name": "testlab-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "commonjs",
  "license": "UNLICENSED",
  "scripts": {
    "sync:prod": "dotenv -e .env.prod -- cross-env NODE_ENV=prod npx prisma db push --force-reset",
    "sync:db": "dotenv -e .env.prod -- cross-env NODE_ENV=prod npx prisma db pull",
    "migrate:prod": "dotenv -e .env.prod -- cross-env NODE_ENV=prod npx prisma migrate dev --name test-lab",
    "migrate:reset": "dotenv -e .env.prod -- cross-env NODE_ENV=prod npx prisma migrate reset",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "dotenv -e .env -- cross-env NODE_ENV=local nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "dotenv -e .env.prod -- cross-env NODE_ENV=prod node dist/src/main",
    "sync:dev": "dotenv -e .env -- cross-env NODE_ENV=local npx prisma db push",
    "migrate:dev": "dotenv -e .env -- cross-env NODE_ENV=local npx prisma migrate dev --name test-lab-db",
    "generate-client": "dotenv -e .env.prod -- cross-env NODE_ENV=prod npx prisma generate",
    "db:seed:dev": "npx dotenv -e .env -- cross-env NODE_ENV=local npx -y tsx prisma/seed.ts",
    "db:normalize:acceptance": "npx dotenv -e .env -- cross-env NODE_ENV=local npx -y tsx scripts/normalize-acceptance-criteria.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "commit": "prettier --write . && git add . && cz"
  },
  "prisma": {
    "seed": "npx -y tsx prisma/seed.ts"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.9.0",
    "cross-env": "^10.1.0",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.3",
    "dotenv": "^17.4.0",
    "dotenv-cli": "^11.0.0",
    "easy-template-x": "^7.2.3",
    "exceljs": "^4.4.0",
    "figlet": "^1.10.0",
    "handlebars": "^4.7.9",
    "hbs": "^4.2.1",
    "html-pdf-node": "^1.0.8",
    "html-to-docx": "^1.8.0",
    "multer": "^2.1.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^8.0.1",
    "nodemailer-express-handlebars": "^7.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pizzip": "^3.2.0",
    "prisma": "^7.4.2",
    "puppeteer": "^24.40.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.18",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/html-pdf-node": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/nodemailer-express-handlebars": "^4.0.6",
    "@types/supertest": "^6.0.2",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
