<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cahier Recette Template Debug</title>
  <style>
    @page {
      size: A4;
      margin: 18mm 14mm;
    }

    * {
      box-sizing: border-box;
    }

    :root {
      --ink: #37352f;
      --muted: rgba(55, 53, 47, 0.62);
      --line: rgba(55, 53, 47, 0.14);
      --soft: #f7f6f3;
      --callout: #f3f7fc;
      --accent: #1f4e79;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: Arial, sans-serif;
      line-height: 1.5;
      white-space: normal;
      font-size: 13px;
      background: #fff;
    }

    article.page {
      max-width: 900px;
      margin: 0 auto;
    }

    .placeholder {
      font-weight: 700;
      color: #1d4ed8;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 4px;
      padding: 1px 4px;
      display: inline-block;
      line-height: 1.35;
    }

    .cover-page {
      min-height: 250mm;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      text-align: center;
    }

    .cover-logos {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 70px;
      margin-bottom: 2rem;
    }

    .cover-title {
      font-size: 2.8rem;
      font-weight: 800;
      color: var(--accent);
      margin: 0;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .cover-subtitle {
      margin: 0;
      font-size: 1.1rem;
      color: var(--muted);
    }

    .cover-meta {
      margin: 0 auto;
      border-collapse: collapse;
      width: 78%;
      max-width: 620px;
    }

    .cover-meta td {
      border: 1px solid var(--line);
      padding: 0.55rem 0.7rem;
      text-align: left;
      font-size: 0.95rem;
    }

    .cover-meta td:first-child {
      width: 34%;
      font-weight: 700;
      background: var(--soft);
    }

    .toc-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent);
      margin: 0 0 0.8rem;
    }

    .toc-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .toc-item {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin: 0.45rem 0;
      font-size: 1rem;
    }

    .toc-item .dots {
      flex: 1;
      border-bottom: 1px dotted #9b9993;
      transform: translateY(-2px);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      letter-spacing: -0.01em;
      line-height: 1.25;
      font-weight: 650;
      margin-bottom: 0.35rem;
      page-break-after: avoid;
    }

    h2 {
      font-size: 1.45rem;
      margin-top: 0.8rem;
      margin-bottom: 0.25rem;
      color: var(--accent);
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.24rem;
    }

    h3 {
      font-size: 1.18rem;
      margin-top: 0.6rem;
      margin-bottom: 0.2rem;
    }

    h4,
    h5 {
      font-size: 1rem;
      margin-top: 1rem;
    }

    p {
      margin: 0.3rem 0;
    }

    ul {
      margin: 0.25rem 0;
      padding-left: 1.5rem;
    }

    li {
      margin: 0.1rem 0;
    }

    .callout {
      border-radius: 10px;
      border: 1px solid rgba(31, 78, 121, 0.18);
      background: var(--callout);
      padding: 0.7rem 0.8rem;
      margin: 0.5rem 0;
      page-break-inside: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.4rem 0 0.6rem;
      table-layout: fixed;
      page-break-inside: avoid;
    }

    th,
    td {
      border: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
      padding: 0.4rem 0.5rem;
      font-size: 0.88rem;
      word-break: break-word;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    th {
      background: var(--soft);
      color: var(--muted);
      font-weight: 650;
    }

    .steps-table col.col-step {
      width: 8%;
    }

    .steps-table col.col-action {
      width: 46%;
    }

    .steps-table col.col-expected {
      width: 46%;
    }

    .suite {
      margin-top: 0.5rem;
      padding-left: 0.9rem;
      border-left: 2px solid var(--line);
    }

    .suite-title {
      margin: 0 0 0.3rem;
      color: #1f3f63;
    }

    .test-case {
      margin: 0.4rem 0 0.6rem;
      padding: 0.6rem 0.7rem;
      border: 1px solid var(--line);
      border-radius: 6px;
      page-break-inside: avoid;
    }

    .test-case-title {
      margin: 0;
      color: #15344f;
      font-size: 0.96rem;
    }

    .summary {
      color: #4e4b45;
      margin-top: 0.15rem;
      margin-bottom: 0.2rem;
    }

    .footer-note {
      margin-top: 1rem;
      border-top: 1px solid var(--line);
      padding-top: 0.5rem;
      display: flex;
      justify-content: space-between;
      gap: 0.8rem;
      font-size: 0.8rem;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <article class="page sans">
    <section class="cover-page section">
      <div class="cover-logos">
        <div></div>
        <div></div>
      </div>

      <div>
        <h1 class="cover-title">Cahier de recette</h1>
        <p class="cover-subtitle">Document de validation fonctionnelle</p>
      </div>

      <table class="cover-meta">
        <tbody>
          <tr><td>Client</td><td><span class="placeholder">{{"{"}}clientName{{"}"}}</span></td></tr>
          <tr><td>Projet</td><td><span class="placeholder">{{"{"}}projectName{{"}"}}</span></td></tr>
          <tr><td>Version</td><td><span class="placeholder">{{"{"}}version{{"}"}}</span></td></tr>
          <tr><td>Date</td><td><span class="placeholder">{{"{"}}date{{"}"}}</span></td></tr>
          <tr><td>Auteur</td><td><span class="placeholder">{{"{"}}author{{"}"}}</span></td></tr>
        </tbody>
      </table>
    </section>

    <section class="section">
      <h2 class="toc-title">Table des matières</h2>
      <ul class="toc-list">
        <li class="toc-item"><span>1. Description du document</span><span class="dots"></span><span>3</span></li>
        <li class="toc-item"><span>2. Objectif du document</span><span class="dots"></span><span>4</span></li>
        <li class="toc-item"><span>3. Informations projet</span><span class="dots"></span><span>5</span></li>
        <li class="toc-item"><span>4. Suites de test</span><span class="dots"></span><span>6</span></li>
        <li class="toc-item"><span>5. Synthèse</span><span class="dots"></span><span>7</span></li>
      </ul>
    </section>

    <div class="page-body">
      <section class="section">
        <h2>Propriétés et contrôle du document</h2>

        <h3>Propriétés</h3>
        <div class="callout">
          Ce document est confidentiel et a été préparé spécialement pour <span class="placeholder">{{"{"}}clientName{{"}"}}</span>.
          Les informations qu'il contient ne doivent pas être transmises à des tiers sans autorisation.
        </div>

        <h3>Contrôle du document</h3>
        <ul>
          <li>Titre : <span class="placeholder">{{"{"}}documentTitle{{"}"}}</span></li>
          <li>Nom de fichier : <span class="placeholder">{{"{"}}fileName{{"}"}}</span></li>
          <li>Type de fichier : Cahier de recette</li>
          <li>Références : <span class="placeholder">{{"{"}}templateName{{"}"}}</span></li>
        </ul>

        <h3>Révisions du document</h3>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Version</th>
              <th>Auteur</th>
              <th>Statut du document</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="placeholder">{{"{"}}date{{"}"}}</span></td>
              <td><span class="placeholder">{{"{"}}version{{"}"}}</span></td>
              <td><span class="placeholder">{{"{"}}author{{"}"}}</span></td>
              <td>Version courante</td>
            </tr>
          </tbody>
        </table>

        <h3>Approbations</h3>
        <table>
          <thead>
            <tr>
              <th>Nom</th>
              <th>Rôle</th>
              <th>Signature</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="placeholder">{{"{"}}approverName{{"}"}}</span></td>
              <td><span class="placeholder">{{"{"}}approverRole{{"}"}}</span></td>
              <td>Signature: __________________</td>
              <td><span class="placeholder">{{"{"}}approvalDate{{"}"}}</span></td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="section">
        <h2>1. Description du document</h2>
        <p><span class="placeholder">{{"{"}}projectDescription{{"}"}}</span></p>

        <h2>2. Objectif du document</h2>
        <p><span class="placeholder">{{"{"}}projectObjective{{"}"}}</span></p>
      </section>

      <section class="section">
        <h2>3. Informations projet</h2>
        <ul>
          <li>Client : <span class="placeholder">{{"{"}}clientName{{"}"}}</span></li>
          <li>Projet / Produit : <span class="placeholder">{{"{"}}projectName{{"}"}}</span></li>
          <li>Version / Sprint : <span class="placeholder">{{"{"}}version{{"}"}}</span></li>
          <li>Périmètre fonctionnel : Suites et cas de test documentés</li>
          <li>Environnement de test : QA</li>
          <li>Équipe QA : <span class="placeholder">{{"{"}}projectOwner{{"}"}}</span></li>
        </ul>
      </section>

      <section class="section">
        <h2>4. Suites de test</h2>

        <div class="suite">
          <h3 class="suite-title"><span class="placeholder">{{"{"}}#suites{{"}"}}</span></h3>
          <h3 class="suite-title"><span class="placeholder">{{"{"}}name{{"}"}}</span></h3>

          <article class="test-case">
            <h5 class="test-case-title"><span class="placeholder">{{"{"}}#testCases{{"}"}}</span></h5>
            <h5 class="test-case-title">Cas de test : <span class="placeholder">{{"{"}}name{{"}"}}</span></h5>
            <p class="summary"><strong>Résumé :</strong> <span class="placeholder">{{"{"}}summary{{"}"}}</span></p>

            <p><strong>Préconditions :</strong></p>
            <ul>
              <li><span class="placeholder">{{"{"}}#preconditions{{"}"}}</span></li>
              <li><span class="placeholder">{{"{"}}content{{"}"}}</span></li>
              <li><span class="placeholder">{{"{"}}/preconditions{{"}"}}</span></li>
            </ul>

            <table class="steps-table">
              <colgroup>
                <col class="col-step" />
                <col class="col-action" />
                <col class="col-expected" />
              </colgroup>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Actions à réaliser</th>
                  <th>Résultats attendus</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><span class="placeholder">{{"{"}}#steps{{"}"}}</span></td>
                  <td><span class="placeholder">{{"{"}}order{{"}"}}. {{"{"}}action{{"}"}} → {{"{"}}expectedResult{{"}"}}</span></td>
                  <td><span class="placeholder">{{"{"}}expectedResult{{"}"}}</span></td>
                </tr>
                <tr>
                  <td colspan="3"><span class="placeholder">{{"{"}}/steps{{"}"}}</span></td>
                </tr>
              </tbody>
            </table>

            <p><span class="placeholder">{{"{"}}/testCases{{"}"}}</span></p>
          </article>

          <p><span class="placeholder">{{"{"}}/suites{{"}"}}</span></p>
        </div>
      </section>

      <section class="section">
        <h2>5. Synthèse</h2>
        <table>
          <thead>
            <tr>
              <th>Indicateur</th>
              <th>Valeur</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Nombre total de cas</td>
              <td><span class="placeholder">{{"{"}}testCaseCount{{"}"}}</span></td>
            </tr>
            <tr>
              <td>Anomalies ouvertes</td>
              <td><span class="placeholder">{{"{"}}openDefects{{"}"}}</span></td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

    <footer class="footer-note">
      <span><span class="placeholder">{{"{"}}footer{{"}"}}</span></span>
    </footer>
  </article>
</body>
</html>
