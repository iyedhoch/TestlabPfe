<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{metadata.title}}</title>
  <style>
    html {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    @page {
      size: A4;
      margin: 18mm 14mm;
    }

    :root {
      --ink: #37352f;
      --muted: rgba(55, 53, 47, 0.64);
      --line: rgba(55, 53, 47, 0.14);
      --soft: #f7f6f3;
      --callout: #eff5fb;
      --accent: #1f4e79;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      line-height: 1.45;
      font-size: 12.5px;
      background: #fff;
    }

    article.page {
      max-width: 900px;
      margin: 0 auto;
    }

    .cover-page,
    .toc-page {
      min-height: 245mm;
    }

    .toc-page {
      page-break-before: always;
    }

    .cover-page {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.8rem;
      text-align: center;
    }

    .cover-title {
      margin: 0;
      font-size: 2.3rem;
      line-height: 1.1;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      font-weight: 800;
    }

    .cover-subtitle {
      margin: 0.25rem 0 0;
      font-size: 1rem;
      color: var(--muted);
    }

    .cover-meta {
      margin: 0 auto;
      border-collapse: collapse;
      width: 84%;
      max-width: 680px;
      text-align: left;
    }

    .cover-meta td {
      border: 1px solid var(--line);
      padding: 0.5rem 0.65rem;
      vertical-align: top;
      font-size: 0.9rem;
    }

    .cover-meta td:first-child {
      width: 34%;
      background: var(--soft);
      font-weight: 700;
    }

    .toc-title {
      margin: 0 0 1rem;
      color: var(--accent);
      font-size: 1.9rem;
      font-weight: 750;
    }

    .toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .toc-item {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin: 0.42rem 0;
      font-size: 0.98rem;
    }

    .toc-item .dots {
      flex: 1;
      border-bottom: 1px dotted #98958d;
      transform: translateY(-2px);
    }

    .section {
      margin-top: 1rem;
    }

    h2,
    h3,
    h4 {
      page-break-after: avoid;
      margin-bottom: 0.35rem;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    h2 {
      margin-top: 0.6rem;
      color: var(--accent);
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.24rem;
      font-size: 1.35rem;
    }

    h3 {
      margin-top: 0.9rem;
      font-size: 1.08rem;
      color: #1f3f63;
    }

    h4 {
      margin-top: 0.7rem;
      font-size: 0.96rem;
      color: #214562;
    }

    p {
      margin: 0.25rem 0;
    }

    ul {
      margin: 0.3rem 0;
      padding-left: 1.4rem;
    }

    li {
      margin: 0.1rem 0;
    }

    .callout {
      border: 1px solid rgba(31, 78, 121, 0.2);
      background: var(--callout);
      border-radius: 8px;
      padding: 0.65rem 0.78rem;
      margin: 0.45rem 0;
      page-break-inside: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.4rem 0 0.65rem;
      table-layout: fixed;
    }

    th,
    td {
      border: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
      padding: 0.38rem 0.48rem;
      font-size: 0.86rem;
      word-break: break-word;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    th {
      background: var(--soft);
      font-weight: 700;
      color: var(--muted);
    }

    .requirement-card,
    .feature-card {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.58rem 0.65rem;
      margin: 0.48rem 0;
      page-break-inside: avoid;
    }

    .meta-line {
      font-size: 0.84rem;
      color: #4f4c46;
      margin-top: 0.2rem;
    }

    .footer-note {
      margin-top: 1rem;
      border-top: 1px solid var(--line);
      padding-top: 0.45rem;
      display: flex;
      justify-content: space-between;
      gap: 0.8rem;
      font-size: 0.78rem;
      color: var(--muted);
    }

    /* ── NEW SECTIONS ──────────────────────────────────────── */

    /* 9. Dashboard screenshots */
    .dashboard-screenshot {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 6px;
      margin: 0.5rem 0 0.2rem;
      page-break-inside: avoid;
    }

    .screenshot-caption {
      font-size: 0.78rem;
      color: var(--muted);
      text-align: center;
      margin-bottom: 0.55rem;
    }

    .screenshot-placeholder {
      width: 100%;
      min-height: 150px;
      border: 1px dashed var(--line);
      border-radius: 6px;
      background: var(--soft);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      font-size: 0.88rem;
      margin: 0.5rem 0 0.3rem;
    }

    /* 10. Navigation table */
    .nav-table col.col-label  { width: 22%; }
    .nav-table col.col-target { width: 28%; }
    .nav-table col.col-type   { width: 18%; }
    .nav-table col.col-access { width: 32%; }

    /* 11. Functional description modules */
    .module-card {
      border-left: 3px solid var(--accent);
      padding: 0.4rem 0.6rem;
      margin: 0.4rem 0;
      background: var(--soft);
      border-radius: 0 6px 6px 0;
      page-break-inside: avoid;
    }

    /* 12. Business rules */
    .rule-card {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.55rem 0.65rem;
      margin: 0.38rem 0;
      page-break-inside: avoid;
    }

    .rule-header {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 0.22rem;
    }

    .rule-id {
      background: var(--accent);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.08rem 0.42rem;
      border-radius: 4px;
      white-space: nowrap;
    }

    .rule-title-text {
      font-weight: 700;
      font-size: 0.93rem;
    }

    .rule-priority {
      margin-left: auto;
      font-size: 0.76rem;
      color: var(--muted);
    }

    /* 13. Acceptance criteria */
    .ac-card {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.55rem 0.65rem;
      margin: 0.38rem 0;
      page-break-inside: avoid;
    }

    .ac-header {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 0.2rem;
    }

    .ac-status {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.08rem 0.42rem;
      border-radius: 4px;
      white-space: nowrap;
    }

    .ac-status-pass { background: #e6f4ea; color: #1e7e34; }
    .ac-status-fail { background: #fdecea; color: #b71c1c; }
    .ac-status-open { background: #fff8e1; color: #795500; }

    .ac-id   { font-weight: 700; font-size: 0.88rem; }
    .ac-story { font-size: 0.82rem; color: var(--muted); }

    .ac-line { font-size: 0.86rem; margin: 0.14rem 0; }
    .kw-given { color: #1f4e79; font-weight: 700; }
    .kw-when  { color: #5c3317; font-weight: 700; }
    .kw-then  { color: #145214; font-weight: 700; }
  </style>
</head>
<body>
  <article class="page">
    <section class="cover-page">
      <div>
        <h1 class="cover-title">Document de Spécification Fonctionnelle</h1>
        <p class="cover-subtitle">Spécification formelle servant de base pour la conception, le développement et la validation</p>
      </div>

      <table class="cover-meta">
        <tbody>
          <tr><td>Titre</td><td>{{metadata.title}}</td></tr>
          <tr><td>Projet / Produit</td><td>{{metadata.projectName}}</td></tr>
          <tr><td>Client</td><td>{{metadata.clientName}}</td></tr>
          <tr><td>Version</td><td>{{metadata.version}}</td></tr>
          <tr><td>Date</td><td>{{formatDate metadata.date}}</td></tr>
          <tr><td>Préparé par</td><td>{{metadata.author}}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="toc-page">
      <h2 class="toc-title">Table des matières</h2>
      <ul class="toc-list">
        <li class="toc-item"><span>1. Responsabilité et maîtrise des documents</span><span class="dots"></span><span>3</span></li>
        <li class="toc-item"><span>2. Introduction</span><span class="dots"></span><span>4</span></li>
        <li class="toc-item"><span>3. Description générale</span><span class="dots"></span><span>5</span></li>
        <li class="toc-item"><span>4. Exigences fonctionnelles</span><span class="dots"></span><span>6</span></li>
        <li class="toc-item"><span>5. Exigences non fonctionnelles</span><span class="dots"></span><span>8</span></li>
        <li class="toc-item"><span>6. Fonctionnalités du système</span><span class="dots"></span><span>9</span></li>
        <li class="toc-item"><span>7. Interfaces externes</span><span class="dots"></span><span>10</span></li>
        <li class="toc-item"><span>8. Approbations</span><span class="dots"></span><span>11</span></li>
        <li class="toc-item"><span>9. Aperçu du tableau de bord</span><span class="dots"></span><span>12</span></li>
        <li class="toc-item"><span>10. Navigation</span><span class="dots"></span><span>13</span></li>
        <li class="toc-item"><span>11. Description fonctionnelle détaillée</span><span class="dots"></span><span>14</span></li>
        <li class="toc-item"><span>12. Règles métier</span><span class="dots"></span><span>15</span></li>
        <li class="toc-item"><span>13. Critères d'acceptation</span><span class="dots"></span><span>16</span></li>
      </ul>
    </section>

    <div class="page-body">
      <!-- ── EXISTING SECTIONS (unchanged) ──────────────────── -->
      <section class="section">
        <h2>1. Responsabilité et maîtrise des documents</h2>
        <div class="callout">
          Ce document est propriété de {{metadata.clientName}} et est maintenu par l'équipe de livraison du projet.
          Toute modification suit les règles de gouvernance standard de révision et de communication des parties prenantes.
        </div>
        <h3>1.1 Maîtrise des documents</h3>
        <table>
          <thead>
            <tr><th>Champ</th><th>Valeur</th></tr>
          </thead>
          <tbody>
            <tr><td>Titre</td><td>{{metadata.title}}</td></tr>
            <tr><td>Type de fichier</td><td>Document de Spécification Fonctionnelle</td></tr>
            <tr><td>Version</td><td>{{metadata.version}}</td></tr>
            <tr><td>Propriétaire</td><td>{{metadata.author}}</td></tr>
          </tbody>
        </table>
      </section>

      <section class="section">
        <h2>2. Introduction</h2>
        <h3>2.1 Objectif</h3>
        <p>{{introduction.purpose}}</p>
        <h3>2.2 Portée</h3>
        <p>{{introduction.scope}}</p>
        {{#if introduction.definitions}}
        <h3>2.3 Définitions</h3>
        <table>
          <thead>
            <tr><th>Terme</th><th>Définition</th></tr>
          </thead>
          <tbody>
            {{#each introduction.definitions}}
            <tr><td>{{term}}</td><td>{{definition}}</td></tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
      </section>

      <section class="section">
        <h2>3. Description générale</h2>
        <h3>3.1 Perspective du produit</h3>
        <p>{{overallDescription.productPerspective}}</p>
        <h3>3.2 Classes d'utilisateurs</h3>
        <p>{{overallDescription.userClasses}}</p>
        <h3>3.3 Hypothèses et dépendances</h3>
        <p>{{overallDescription.assumptions}}</p>
      </section>

      <section class="section">
        <h2>4. Exigences fonctionnelles</h2>
        {{#each functionalRequirements}}
        <article class="requirement-card">
          <h3>{{id}} - {{title}}</h3>
          <p>{{description}}</p>
          <p class="meta-line"><strong>Priorité :</strong> {{priority}}</p>
          {{#if relatedUserStory}}
          <p class="meta-line"><strong>Récit utilisateur associé :</strong> {{relatedUserStory}}</p>
          {{/if}}
        </article>
        {{/each}}
      </section>

      <section class="section">
        <h2>5. Exigences non fonctionnelles</h2>
        <table>
          <thead>
            <tr><th>Catégorie</th><th>Exigence</th></tr>
          </thead>
          <tbody>
            <tr><td>Performance</td><td>{{nonFunctionalRequirements.performance}}</td></tr>
            <tr><td>Sécurité</td><td>{{nonFunctionalRequirements.security}}</td></tr>
            <tr><td>Utilisabilité</td><td>{{nonFunctionalRequirements.usability}}</td></tr>
          </tbody>
        </table>
      </section>

      <section class="section">
        <h2>6. Fonctionnalités du système</h2>
        {{#each systemFeatures}}
        <article class="feature-card">
          <h3>{{name}}</h3>
          <p>{{description}}</p>
          {{#if userStories}}
          <h4>Récits utilisateurs</h4>
          <ul>
            {{#each userStories}}
            <li><strong>{{id}} - {{title}}</strong> : {{description}}</li>
            {{/each}}
          </ul>
          {{/if}}
        </article>
        {{/each}}
      </section>

      {{#if externalInterfaces}}
      <section class="section">
        <h2>7. Interfaces externes</h2>
        <h3>7.1 Interface utilisateur</h3>
        <p>{{externalInterfaces.userInterface}}</p>
        <h3>7.2 Interfaces API</h3>
        <p>{{externalInterfaces.apiInterfaces}}</p>
      </section>
      {{/if}}

      <section class="section">
        <h2>8. Approbations</h2>
        <table>
          <thead>
            <tr><th>Nom</th><th>Rôle</th><th>Date</th></tr>
          </thead>
          <tbody>
            {{#each approvals}}
            <tr>
              <td>{{name}}</td>
              <td>{{role}}</td>
              <td>{{formatDate date}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>

      <!-- ══════════════════════════════════════════════════════
           9. DASHBOARD SCREENSHOT
           ──────────────────────────────────────────────────────
           Data key: dashboardScreenshots  (array, optional)
             Each item: { url, caption, altText }
           If the array is absent/empty a placeholder is shown.
      ══════════════════════════════════════════════════════ -->
      <section class="section">
        <h2>9. Aperçu du tableau de bord</h2>
        <p>Capture(s) représentative(s) de l'interface principale permettant de visualiser le périmètre fonctionnel couvert.</p>

        {{#if dashboardScreenshots}}
          {{#each dashboardScreenshots}}
          <figure style="margin:0.4rem 0;">
            <img src="{{url}}" alt="{{altText}}" class="dashboard-screenshot" />
            {{#if caption}}
            <figcaption class="screenshot-caption">{{caption}}</figcaption>
            {{/if}}
          </figure>
          {{/each}}
        {{else}}
          <div class="screenshot-placeholder">
            [ Capture d'écran du tableau de bord — à insérer ]
          </div>
          <p class="screenshot-caption">Aucune capture fournie pour cette version.</p>
        {{/if}}
      </section>

      <!-- ══════════════════════════════════════════════════════
           10. NAVIGATION TABLE
           ──────────────────────────────────────────────────────
           Data key: navigationItems  (array, optional)
             Each item: { label, targetPage, type, accessRoles }
           type examples: "Lien menu", "Bouton", "Onglet", "Breadcrumb"
      ══════════════════════════════════════════════════════ -->
      <section class="section">
        <h2>10. Navigation</h2>
        <p>Recensement des éléments de navigation de l'interface et des droits d'accès associés par rôle utilisateur.</p>

        <table class="nav-table">
          <colgroup>
            <col class="col-label"  />
            <col class="col-target" />
            <col class="col-type"   />
            <col class="col-access" />
          </colgroup>
          <thead>
            <tr>
              <th>Libellé</th>
              <th>Page / Destination</th>
              <th>Type</th>
              <th>Rôles autorisés</th>
            </tr>
          </thead>
          <tbody>
            {{#each navigationItems}}
            <tr>
              <td>{{label}}</td>
              <td>{{targetPage}}</td>
              <td>{{type}}</td>
              <td>{{accessRoles}}</td>
            </tr>
            {{else}}
            <tr>
              <td colspan="4" style="text-align:center;color:var(--muted);">
                Aucun élément de navigation défini.
              </td>
            </tr>
            {{/each}}
          </tbody>
        </table>
      </section>

      <!-- ══════════════════════════════════════════════════════
           11. FUNCTIONAL DESCRIPTION (detailed)
           ──────────────────────────────────────────────────────
           Data key: functionalDescription  (string — HTML allowed)
           Data key: functionalModules      (array, optional)
             Each item: { title, description }
      ══════════════════════════════════════════════════════ -->
      <section class="section">
        <h2>11. Description fonctionnelle détaillée</h2>

        {{#if functionalDescription}}
        <p>{{{functionalDescription}}}</p>
        {{/if}}

        {{#if functionalModules}}
        {{#each functionalModules}}
        <div class="module-card">
          <h3 style="margin:0 0 0.2rem;">{{title}}</h3>
          <p style="margin:0;">{{description}}</p>
        </div>
        {{/each}}
        {{/if}}

        {{#unless functionalDescription}}
        {{#unless functionalModules}}
        <div class="callout">Aucune description fonctionnelle détaillée fournie pour cette version.</div>
        {{/unless}}
        {{/unless}}
      </section>

      <!-- ══════════════════════════════════════════════════════
           12. BUSINESS RULES
           ──────────────────────────────────────────────────────
           Data key: businessRules  (array)
             Each item: { id, title, description, source?, priority? }
           priority: "Haute" | "Moyenne" | "Basse"
      ══════════════════════════════════════════════════════ -->
      <section class="section">
        <h2>12. Règles métier</h2>
        <p>Contraintes et comportements attendus du système, indépendamment de toute implémentation technique.</p>

        {{#each businessRules}}
        <div class="rule-card">
          <div class="rule-header">
            <span class="rule-id">{{id}}</span>
            <span class="rule-title-text">{{title}}</span>
            {{#if priority}}
            <span class="rule-priority">Priorité : {{priority}}</span>
            {{/if}}
          </div>
          <p style="margin:0 0 0.12rem;">{{description}}</p>
          {{#if source}}
          <p style="margin:0;font-size:0.78rem;color:var(--muted);">Source : {{source}}</p>
          {{/if}}
        </div>
        {{else}}
        <div class="callout">Aucune règle métier définie pour cette version.</div>
        {{/each}}
      </section>

      <!-- ══════════════════════════════════════════════════════
           13. ACCEPTANCE CRITERIA
           ──────────────────────────────────────────────────────
           Data key: acceptanceCriteria  (array)
             Each item: { id, userStory, given, when, then, status }
           status: "open" | "pass" | "fail"
      ══════════════════════════════════════════════════════ -->
      <section class="section">
        <h2>13. Critères d'acceptation</h2>
        <p>Format <em>Given / When / Then</em> (Gherkin), directement liés aux user stories du projet.</p>

        {{#each acceptanceCriteria}}
        <div class="ac-card">
          <div class="ac-header">
            <span class="ac-status {{#if (eq status 'pass')}}ac-status-pass{{else}}{{#if (eq status 'fail')}}ac-status-fail{{else}}ac-status-open{{/if}}{{/if}}">
              {{#if (eq status 'pass')}}✔ Validé{{else}}{{#if (eq status 'fail')}}✘ Échoué{{else}}En attente{{/if}}{{/if}}
            </span>
            <span class="ac-id">{{id}}</span>
            <span class="ac-story">— {{userStory}}</span>
          </div>
          <p class="ac-line"><span class="kw-given">Étant donné que</span> {{given}}</p>
          <p class="ac-line"><span class="kw-when">Quand</span> {{when}}</p>
          <p class="ac-line"><span class="kw-then">Alors</span> {{then}}</p>
        </div>
        {{else}}
        <div class="callout">Aucun critère d'acceptation défini pour cette version.</div>
        {{/each}}
      </section>
    </div>

    <footer class="footer-note">
      <span>{{template.footer}}</span>
    </footer>
  </article>
</body>
</html>
