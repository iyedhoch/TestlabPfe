<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FSD Debug Template</title>
  <style>
    html {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    @page {
      size: A4;
      margin: 18mm 14mm;
    }

    :root {
      --ink: #37352f;
      --muted: rgba(55, 53, 47, 0.64);
      --line: rgba(55, 53, 47, 0.14);
      --soft: #f7f6f3;
      --callout: #eff5fb;
      --accent: #1f4e79;
      --debug: #c62828;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      line-height: 1.45;
      font-size: 12.5px;
      background: #fff;
    }

    article.page {
      max-width: 900px;
      margin: 0 auto;
    }

    .cover-page,
    .toc-page {
      min-height: 245mm;
    }

    .toc-page {
      page-break-before: always;
    }

    .cover-page {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1.8rem;
      text-align: center;
    }

    .cover-title {
      margin: 0;
      font-size: 2.3rem;
      line-height: 1.1;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.02em;
      font-weight: 800;
    }

    .cover-subtitle {
      margin: 0.25rem 0 0;
      font-size: 1rem;
      color: var(--muted);
    }

    .debug-var {
      color: var(--debug);
      font-weight: 700;
      white-space: nowrap;
    }

    .cover-meta {
      margin: 0 auto;
      border-collapse: collapse;
      width: 84%;
      max-width: 680px;
      text-align: left;
    }

    .cover-meta td {
      border: 1px solid var(--line);
      padding: 0.5rem 0.65rem;
      vertical-align: top;
      font-size: 0.9rem;
    }

    .cover-meta td:first-child {
      width: 34%;
      background: var(--soft);
      font-weight: 700;
    }

    .toc-title {
      margin: 0 0 1rem;
      color: var(--accent);
      font-size: 1.9rem;
      font-weight: 750;
    }

    .toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .toc-item {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin: 0.42rem 0;
      font-size: 0.98rem;
    }

    .toc-item .dots {
      flex: 1;
      border-bottom: 1px dotted #98958d;
      transform: translateY(-2px);
    }

    .section {
      margin-top: 1rem;
    }

    h2,
    h3,
    h4 {
      page-break-after: avoid;
      margin-bottom: 0.35rem;
      letter-spacing: -0.01em;
      line-height: 1.2;
    }

    h2 {
      margin-top: 0.6rem;
      color: var(--accent);
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.24rem;
      font-size: 1.35rem;
    }

    h3 {
      margin-top: 0.9rem;
      font-size: 1.08rem;
      color: #1f3f63;
    }

    h4 {
      margin-top: 0.7rem;
      font-size: 0.96rem;
      color: #214562;
    }

    p {
      margin: 0.25rem 0;
    }

    ul {
      margin: 0.3rem 0;
      padding-left: 1.4rem;
    }

    li {
      margin: 0.1rem 0;
    }

    .callout {
      border: 1px solid rgba(31, 78, 121, 0.2);
      background: var(--callout);
      border-radius: 8px;
      padding: 0.65rem 0.78rem;
      margin: 0.45rem 0;
      page-break-inside: avoid;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.4rem 0 0.65rem;
      table-layout: fixed;
    }

    th,
    td {
      border: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
      padding: 0.38rem 0.48rem;
      font-size: 0.86rem;
      word-break: break-word;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    th {
      background: var(--soft);
      font-weight: 700;
      color: var(--muted);
    }

    .requirement-card,
    .feature-card {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 0.58rem 0.65rem;
      margin: 0.48rem 0;
      page-break-inside: avoid;
    }

    .meta-line {
      font-size: 0.84rem;
      color: #4f4c46;
      margin-top: 0.2rem;
    }

    .footer-note {
      margin-top: 1rem;
      border-top: 1px solid var(--line);
      padding-top: 0.45rem;
      display: flex;
      justify-content: space-between;
      gap: 0.8rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
  </style>
</head>
<body>
  <article class="page">
    <section class="cover-page">
      <div>
        <h1 class="cover-title">Functional Specification Document</h1>
        <p class="cover-subtitle">Formal specification baseline for design, development, and validation</p>
      </div>

      <table class="cover-meta">
        <tbody>
          <tr><td>Title</td><td><span class="debug-var">🔴 &#123;&#123;metadata.title&#125;&#125;</span></td></tr>
          <tr><td>Project / Product</td><td><span class="debug-var">🔴 &#123;&#123;metadata.projectName&#125;&#125;</span></td></tr>
          <tr><td>Client</td><td><span class="debug-var">🔴 &#123;&#123;metadata.clientName&#125;&#125;</span></td></tr>
          <tr><td>Version</td><td><span class="debug-var">🔴 &#123;&#123;metadata.version&#125;&#125;</span></td></tr>
          <tr><td>Date</td><td><span class="debug-var">🔴 &#123;&#123;metadata.date&#125;&#125;</span></td></tr>
          <tr><td>Prepared by</td><td><span class="debug-var">🔴 &#123;&#123;metadata.author&#125;&#125;</span></td></tr>
        </tbody>
      </table>
    </section>

    <section class="toc-page">
      <h2 class="toc-title">Table des matieres</h2>
      <ul class="toc-list">
        <li class="toc-item"><span>1. Ownership and document control</span><span class="dots"></span><span>3</span></li>
        <li class="toc-item"><span>2. Introduction</span><span class="dots"></span><span>4</span></li>
        <li class="toc-item"><span>3. Overall description</span><span class="dots"></span><span>5</span></li>
        <li class="toc-item"><span>4. Functional requirements</span><span class="dots"></span><span>6</span></li>
        <li class="toc-item"><span>5. Non-functional requirements</span><span class="dots"></span><span>8</span></li>
        <li class="toc-item"><span>6. System features</span><span class="dots"></span><span>9</span></li>
        <li class="toc-item"><span>7. External interfaces</span><span class="dots"></span><span>10</span></li>
        <li class="toc-item"><span>8. Approvals</span><span class="dots"></span><span>11</span></li>
      </ul>
    </section>

    <div class="page-body">
      <section class="section">
        <h2>1. Ownership and document control</h2>

        <div class="callout">
          This document is owned by <span class="debug-var">🔴 &#123;&#123;metadata.clientName&#125;&#125;</span> and maintained by the project delivery team.
          Any modification follows standard revision governance and stakeholder communication rules.
        </div>

        <h3>1.1 Document control</h3>
        <table>
          <thead>
            <tr>
              <th>Field</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Title</td><td><span class="debug-var">🔴 &#123;&#123;metadata.title&#125;&#125;</span></td></tr>
            <tr><td>File Type</td><td>Functional Specification Document</td></tr>
            <tr><td>Version</td><td><span class="debug-var">🔴 &#123;&#123;metadata.version&#125;&#125;</span></td></tr>
            <tr><td>Owner</td><td><span class="debug-var">🔴 &#123;&#123;metadata.author&#125;&#125;</span></td></tr>
          </tbody>
        </table>
      </section>

      <section class="section">
        <h2>2. Introduction</h2>

        <h3>2.1 Purpose</h3>
        <p><span class="debug-var">🔴 &#123;&#123;introduction.purpose&#125;&#125;</span></p>

        <h3>2.2 Scope</h3>
        <p><span class="debug-var">🔴 &#123;&#123;introduction.scope&#125;&#125;</span></p>

        <h3>2.3 Definitions</h3>
        <table>
          <thead>
            <tr>
              <th>Term</th>
              <th>Definition</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="debug-var">🔴 &#123;&#123;introduction.definitions[0].term&#125;&#125;</span></td>
              <td><span class="debug-var">🔴 &#123;&#123;introduction.definitions[0].definition&#125;&#125;</span></td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="section">
        <h2>3. Description generale</h2>

        <h3>3.1 Product perspective</h3>
        <p><span class="debug-var">🔴 &#123;&#123;overallDescription.productPerspective&#125;&#125;</span></p>

        <h3>3.2 User classes</h3>
        <p><span class="debug-var">🔴 &#123;&#123;overallDescription.userClasses&#125;&#125;</span></p>

        <h3>3.3 Assumptions and dependencies</h3>
        <p><span class="debug-var">🔴 &#123;&#123;overallDescription.assumptions&#125;&#125;</span></p>
      </section>

      <section class="section">
        <h2>4. Exigences fonctionnelles</h2>
        <article class="requirement-card">
          <h3><span class="debug-var">🔴 &#123;&#123;functionalRequirements[0].id&#125;&#125;</span> - <span class="debug-var">🔴 &#123;&#123;functionalRequirements[0].title&#125;&#125;</span></h3>
          <p><span class="debug-var">🔴 &#123;&#123;functionalRequirements[0].description&#125;&#125;</span></p>
          <p class="meta-line"><strong>Priority:</strong> <span class="debug-var">🔴 &#123;&#123;functionalRequirements[0].priority&#125;&#125;</span></p>
          <p class="meta-line"><strong>Related user story:</strong> <span class="debug-var">🔴 &#123;&#123;functionalRequirements[0].relatedUserStory&#125;&#125;</span></p>
        </article>
      </section>

      <section class="section">
        <h2>5. Exigences non fonctionnelles</h2>
        <table>
          <thead>
            <tr>
              <th>Category</th>
              <th>Requirement</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>Performance</td><td><span class="debug-var">🔴 &#123;&#123;nonFunctionalRequirements.performance&#125;&#125;</span></td></tr>
            <tr><td>Security</td><td><span class="debug-var">🔴 &#123;&#123;nonFunctionalRequirements.security&#125;&#125;</span></td></tr>
            <tr><td>Usability</td><td><span class="debug-var">🔴 &#123;&#123;nonFunctionalRequirements.usability&#125;&#125;</span></td></tr>
          </tbody>
        </table>
      </section>

      <section class="section">
        <h2>6. Fonctionnalites systeme</h2>
        <article class="feature-card">
          <h3><span class="debug-var">🔴 &#123;&#123;systemFeatures[0].name&#125;&#125;</span></h3>
          <p><span class="debug-var">🔴 &#123;&#123;systemFeatures[0].description&#125;&#125;</span></p>
          <h4>User stories</h4>
          <ul>
            <li><strong><span class="debug-var">🔴 &#123;&#123;systemFeatures[0].userStories[0].id&#125;&#125;</span> - <span class="debug-var">🔴 &#123;&#123;systemFeatures[0].userStories[0].title&#125;&#125;</span></strong>: <span class="debug-var">🔴 &#123;&#123;systemFeatures[0].userStories[0].description&#125;&#125;</span></li>
          </ul>
        </article>
      </section>

      <section class="section">
        <h2>7. Interfaces externes</h2>
        <h3>7.1 User interface</h3>
        <p><span class="debug-var">🔴 &#123;&#123;externalInterfaces.userInterface&#125;&#125;</span></p>

        <h3>7.2 API interfaces</h3>
        <p><span class="debug-var">🔴 &#123;&#123;externalInterfaces.apiInterfaces&#125;&#125;</span></p>
      </section>

      <section class="section">
        <h2>8. Approvals</h2>
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Role</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><span class="debug-var">🔴 &#123;&#123;approvals[0].name&#125;&#125;</span></td>
              <td><span class="debug-var">🔴 &#123;&#123;approvals[0].role&#125;&#125;</span></td>
              <td><span class="debug-var">🔴 &#123;&#123;approvals[0].date&#125;&#125;</span></td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

    <footer class="footer-note">
      <span><span class="debug-var">🔴 &#123;&#123;template.footer&#125;&#125;</span></span>
    </footer>
  </article>
</body>
</html>
