<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{metadata.title}}</title>
  <style>
    html {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }


    :root {
      --ink: #37352f;
      --muted: rgba(55, 53, 47, 0.62);
      --line: rgba(55, 53, 47, 0.14);
      --soft: #f7f6f3;
      --callout: #f3f7fc;
      --accent: #1f4e79;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      line-height: 1.5;
      white-space: normal;
      font-size: 13px;
      background: #fff;
    }

    article.page {
      max-width: 900px;
      margin: 0 auto;
    }

    .page-break {
      /* Only used for explicit breaks on cover page via inline styles */
      page-break-before: always;
    }

    .cover-page {
      min-height: 250mm;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 2rem;
      text-align: center;
    }

    .cover-logos {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 70px;
      margin-bottom: 2rem;
    }

    .cover-title {
      font-size: 2.8rem;
      font-weight: 800;
      color: var(--accent);
      margin: 0;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .cover-subtitle {
      margin: 0;
      font-size: 1.1rem;
      color: var(--muted);
    }

    .cover-meta {
      margin: 0 auto;
      border-collapse: collapse;
      width: 78%;
      max-width: 620px;
    }

    .cover-meta td {
      border: 1px solid var(--line);
      padding: 0.55rem 0.7rem;
      text-align: left;
      font-size: 0.95rem;
    }

    .cover-meta td:first-child {
      width: 34%;
      font-weight: 700;
      background: var(--soft);
    }

    .company-logo,
    .client-logo {
      max-height: 64px;
      max-width: 220px;
      object-fit: contain;
    }


    .toc-page {
      /* Removed min-height to allow natural flow */
    }

    .toc-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--accent);
      margin: 0 0 0.8rem;
    }

    .toc-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .toc-item {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin: 0.45rem 0;
      font-size: 1rem;
    }

    .toc-item .dots {
      flex: 1;
      border-bottom: 1px dotted #9b9993;
      transform: translateY(-2px);
    }

    h1,
    h2,
    h3,
    h4,
    h5 {
      letter-spacing: -0.01em;
      line-height: 1.25;
      font-weight: 650;
      margin-bottom: 0.35rem;
      page-break-after: avoid;
    }

    h2 {
      font-size: 1.45rem;
      margin-top: 0.8rem;
      margin-bottom: 0.25rem;
      color: var(--accent);
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.24rem;
    }

    h3 {
      font-size: 1.18rem;
      margin-top: 0.6rem;
      margin-bottom: 0.2rem;
    }

    h4,
    h5 {
      font-size: 1rem;
      margin-top: 1rem;
    }

    p {
      margin: 0.3rem 0;
    }

    ul {
      margin: 0.25rem 0;
      padding-left: 1.5rem;
    }

    li {
      margin: 0.1rem 0;
    }

    .callout {
      border-radius: 10px;
      border: 1px solid rgba(31, 78, 121, 0.18);
      background: var(--callout);
      padding: 0.7rem 0.8rem;
      margin: 0.5rem 0;
      page-break-inside: avoid;
    }

    .section {
      /* Removed page-break-inside: avoid to allow natural content flow */
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin: 0.4rem 0 0.6rem;
      table-layout: fixed;
      page-break-inside: avoid;
    }

    thead {
      display: table-header-group;
    }



    tr {
      page-break-inside: avoid;
    }

    th,
    td {
      border: 1px solid var(--line);
      text-align: left;
      vertical-align: top;
      padding: 0.4rem 0.5rem;
      font-size: 0.88rem;
      word-break: break-word;
      overflow-wrap: anywhere;
      white-space: normal;
    }

    th {
      background: var(--soft);
      color: var(--muted);
      font-weight: 650;
    }

    .steps-table col.col-step {
      width: 8%;
    }

    .steps-table col.col-action {
      width: 46%;
    }

    .steps-table col.col-expected {
      width: 46%;
    }

    .suite {
      margin-top: 0.5rem;
      padding-left: 0.9rem;
      border-left: 2px solid var(--line);
      /* Removed page-break-inside: avoid to allow suites to flow across pages */
    }

    .suite + .suite {
      /* Removed page-break-before: always to enable natural pagination */
    }

    .suite-title {
      margin: 0 0 0.3rem;
      color: #1f3f63;
    }

    .test-case {
      margin: 0.4rem 0 0.6rem;
      padding: 0.6rem 0.7rem;
      border: 1px solid var(--line);
      border-radius: 6px;
      page-break-inside: avoid;
    }

    .test-case-title {
      margin: 0;
      color: #15344f;
      font-size: 0.96rem;
    }

    .summary {
      color: #4e4b45;
      margin-top: 0.15rem;
      margin-bottom: 0.2rem;
    }

  </style>
</head>
<body>
  <article class="page sans">
    <section class="cover-page section">
      <div>
        <h1 class="cover-title">Cahier de recette</h1>
        <p class="cover-subtitle">Document de validation fonctionnelle</p>
      </div>

      <table class="cover-meta">
        <tbody>
          <tr><td>Client</td><td data-edit-path="metadata.clientName">{{metadata.clientName}}</td></tr>
          <tr><td>Projet</td><td data-edit-path="project.name">{{project.name}}</td></tr>
          <tr><td>Version</td><td data-edit-path="metadata.version">{{metadata.version}}</td></tr>
          <tr><td>Date</td><td data-edit-path="metadata.date">{{formatDate metadata.date}}</td></tr>
          <tr><td>Auteur</td><td data-edit-path="metadata.author">{{metadata.author}}</td></tr>
        </tbody>
      </table>
    </section>

    <section class="toc-page section">
      <h2 class="toc-title">Table des matières</h2>
      <ul class="toc-list">
        <li class="toc-item"><a href="#section-1" style="color:inherit;text-decoration:none;">1. Description du document</a><span class="dots"></span><span>3</span></li>
        <li class="toc-item"><a href="#section-2" style="color:inherit;text-decoration:none;">2. Objectif du document</a><span class="dots"></span><span>4</span></li>
        <li class="toc-item"><a href="#section-3" style="color:inherit;text-decoration:none;">3. Informations projet</a><span class="dots"></span><span>5</span></li>
        <li class="toc-item"><a href="#section-4" style="color:inherit;text-decoration:none;">4. Suites de test</a><span class="dots"></span><span>6</span></li>
        <li class="toc-item"><a href="#section-5" style="color:inherit;text-decoration:none;">5. Synthèse</a><span class="dots"></span><span>7</span></li>
      </ul>
    </section>

    <div class="page-body">
      <section class="section">
        <h2>Propriétés et contrôle du document</h2>

        <h3>Propriétés</h3>
        <div class="callout">
          Ce document est confidentiel et a été préparé spécialement pour <span data-edit-path="metadata.clientName">{{metadata.clientName}}</span>.
          Les informations qu'il contient ne doivent pas être transmises à des tiers sans autorisation.
        </div>

        <h3>Contrôle du document</h3>
        <ul>
          <li>Titre : <span data-edit-path="metadata.title">{{metadata.title}}</span></li>
          <li>Nom de fichier : cahier-recette-{{project.id}}-{{metadata.version}}.pdf</li>
          <li>Type de fichier : Cahier de recette</li>
          <li>Références : <span data-edit-path="template.name">{{template.name}}</span></li>
        </ul>

        <h3>Révisions du document</h3>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Version</th>
              <th>Auteur</th>
              <th>Statut du document</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td data-edit-path="metadata.date">{{formatDate metadata.date}}</td>
              <td data-edit-path="metadata.version">{{metadata.version}}</td>
              <td data-edit-path="metadata.author">{{metadata.author}}</td>
              <td>Version courante</td>
            </tr>
          </tbody>
        </table>

        {{#if template.showApprovals}}
        <h3>Approbations</h3>
        <table>
          <thead>
            <tr>
              <th>Nom</th>
              <th>Rôle</th>
              <th>Signature</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            {{#each approvals}}
            <tr>
              <td data-edit-path="approvals.{{@index}}.name">{{name}}</td>
              <td data-edit-path="approvals.{{@index}}.role">{{role}}</td>
              <td>Signature: __________________</td>
              <td data-edit-path="approvals.{{@index}}.date">{{formatDate date}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>
        {{/if}}
      </section>

      {{#if template.showContext}}
      <section class="section">
        <h2 id="section-1">1. Description du document</h2>
        <p data-edit-path="context.description">{{context.description}}</p>

        <h2 id="section-2">2. Objectif du document</h2>
        <p data-edit-path="context.objective">{{context.objective}}</p>
      </section>
      {{/if}}

      <section class="section">
        <h2 id="section-3">3. Informations projet</h2>
        <ul>
          <li>Client : <span data-edit-path="metadata.clientName">{{metadata.clientName}}</span></li>
          <li>Projet / Produit : <span data-edit-path="project.name">{{project.name}}</span></li>
          <li>Version / Sprint : <span data-edit-path="metadata.version">{{metadata.version}}</span></li>
          <li>Périmètre fonctionnel : Suites et cas de test documentés</li>
          <li>Environnement de test : QA</li>
          <li>Équipe QA : <span data-edit-path="project.owner">{{project.owner}}</span></li>
        </ul>
      </section>

      <section class="section">
        <h2 id="section-4">4. Suites de test</h2>

        {{#*inline "suiteNode"}}
        <div class="suite suite-depth-{{depth}}">
          <h3 class="suite-title">{{numbering}} <span data-edit-path="{{editPath}}.name">{{name}}</span></h3>

          {{#each testCases}}
          <article class="test-case">
            <h5 class="test-case-title">Cas de test {{sectionNumber ../numbering @index}} {{code}} : <span data-edit-path="{{editPath}}.name">{{name}}</span></h5>
            <p class="summary"><strong>Résumé :</strong> <span data-edit-path="{{editPath}}.summary">{{summary}}</span></p>

            {{#if @root.template.showPreconditions}}
            <p><strong>Préconditions :</strong></p>
            <ul>
              {{#each preconditions}}
              <li data-edit-path="{{../editPath}}.preconditions.{{@index}}.content">{{content}}</li>
              {{/each}}
            </ul>
            {{/if}}

            {{#if @root.template.showSteps}}
            <table class="steps-table">
              <colgroup>
                <col class="col-step" />
                <col class="col-action" />
                <col class="col-expected" />
              </colgroup>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Actions à réaliser</th>
                  <th>Résultats attendus</th>
                </tr>
              </thead>
              <tbody>
                {{#each steps}}
                <tr>
                  <td data-edit-path="{{../editPath}}.steps.{{@index}}.order">{{order}}</td>
                  <td data-edit-path="{{../editPath}}.steps.{{@index}}.action">{{action}}</td>
                  <td data-edit-path="{{../editPath}}.steps.{{@index}}.expectedResult">{{expectedResult}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            {{/if}}
          </article>
          {{/each}}

          {{#each children}}
            {{> suiteNode}}
          {{/each}}
        </div>
        {{/inline}}

        {{#each suites}}
          {{> suiteNode}}
        {{/each}}
      </section>

      <section class="section">
        <h2 id="section-5">5. Synthèse</h2>
        <table>
          <thead>
            <tr>
              <th>Indicateur</th>
              <th>Valeur</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Nombre total de cas</td>
              <td>{{metadata.version}}</td>
            </tr>
            <tr>
              <td>Anomalies ouvertes</td>
              <td>Voir suivi QA</td>
            </tr>
          </tbody>
        </table>
      </section>
    </div>

  </article>
</body>
</html>
