// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  QA
  BA
}

model Project {
  id            String        @id @default(uuid())
  prefix        String        @unique
  name          String
  description   String        @default("")
  clientName    String?       @default("Default Client")
  projectOwner  String?       @default("John Doe")
  openDefects   Int           @default(0)
  clickupListId String        @default("")
  status        ProjectStatus @default(ACTIVE)
  creationDate  DateTime      @default(now())

  testCaseCount    Int @default(0)
  campaignCount    Int @default(0)
  userStoryCount   Int @default(0)
  fsdDocumentCount Int @default(0)

  lastExecutionDate DateTime?

  platforms   Platform[]
  testSuites  TestSuite[]
  epics       Epic[]
  environment Environment[]
  approvals   DocumentApproval[]
  fsdDashboardScreenshots FsdDashboardScreenshot[]
  fsdReferenceDocuments   FsdReferenceDocument[]
  fsdGlossaryEntries      FsdGlossary[]
  fsdRevisions            FsdRevision[]
  fsdNavigationItems      FsdNavigationItem[]
  fsdFunctionalModules    FsdFunctionalModule[]
  fsdBusinessRules        FsdBusinessRule[]
  fsdAcceptanceCriteria   FsdAcceptanceCriteria[]
  documentVersions        DocumentVersion[]

  attachment String?
  figmaLink  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("projects")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model DocumentApproval {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  approverName String
  approverRole String
  approvalDate DateTime

  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("document_approvals")
}

model FsdDashboardScreenshot {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  url     String
  altText String?
  caption String?
  order   Int     @default(0)

  @@index([projectId, order])
  @@map("fsd_dashboard_screenshots")
}

model FsdReferenceDocument {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  type       String
  attachment String
  order      Int     @default(0)

  @@index([projectId, order])
  @@map("fsd_reference_documents")
}

model FsdGlossary {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  term    String
  comment String
  order   Int     @default(0)

  @@index([projectId, order])
  @@map("fsd_glossary")
}

model FsdRevision {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  date    DateTime
  version String
  status  String
  author  String
  order   Int      @default(0)

  @@index([projectId, order])
  @@map("fsd_revisions")
}

model FsdNavigationItem {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label       String
  targetPage  String
  type        String
  accessRoles String
  order       Int     @default(0)

  @@index([projectId, order])
  @@map("fsd_navigation_items")
}

model FsdFunctionalModule {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String
  order       Int     @default(0)

  @@index([projectId, order])
  @@map("fsd_functional_modules")
}

model FsdBusinessRule {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ruleId      String
  title       String
  description String
  priority    String?
  source      String?
  order       Int     @default(0)

  @@index([projectId, order])
  @@map("fsd_business_rules")
}

model FsdAcceptanceCriteria {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  criteriaId String
  userStory  String
  given      String
  when       String
  then       String
  status     String  @default("open")
  order      Int

  @@index([projectId, order])
  @@map("fsd_acceptance_criteria")
}

model DocumentVersion {
  id                 String                @id @default(uuid())
  projectId          String
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentType       String
  documentName       String
  threadId           String
  versionNumber      Int                   @default(1)
  status             DocumentVersionStatus @default(IN_PROGRESS)
  createdByName      String
  createdByInitials  String
  payloadSnapshot    Json
  sourceVersionId    String?
  sourceVersion      DocumentVersion?      @relation("DocumentVersionLineage", fields: [sourceVersionId], references: [id], onDelete: SetNull)
  derivedVersions    DocumentVersion[]     @relation("DocumentVersionLineage")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([projectId, createdAt])
  @@index([projectId, threadId, versionNumber])
  @@index([projectId, documentType, status])
  @@map("document_versions")
}

model TestSuite {
  id    String @id @default(uuid())
  name  String
  order Int    @default(1)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?
  parent   TestSuite?  @relation("SuiteHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children TestSuite[] @relation("SuiteHierarchy")

  testCases TestCase[]

  @@index([projectId])
  @@map("test_suites")
}

model TestCase {
  id      String @id @default(uuid())
  name    String
  summary String @default("")

  testSuiteId String
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)

  preconditions Precondition[]
  steps         TestStep[]

  @@index([testSuiteId])
  @@map("test_cases")
}

model Precondition {
  id      String @id @default(uuid())
  content String
  order   Int    @default(1)

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("preconditions")
}

model TestStep {
  id             String @id @default(uuid())
  action         String
  expectedResult String
  order          Int    @default(0)

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@map("test_steps")
}

model Epic {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  creationDate DateTime @default(now())

  status   EpicStatus   @default(NEW)
  priority EpicPriority @default(LOW)
  tagId    String?
  tag      Tag?         @relation(fields: [tagId], references: [id], onDelete: SetNull)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  features Feature[]

  @@index([tagId])
  @@map("epics")
}

model Feature {
  id           String   @id @default(uuid())
  name         String
  description  String?  @default("")
  creationDate DateTime @default(now())

  status   FeatureStatus   @default(NEW)
  priority FeaturePriority @default(MEDIUM)
  tagId    String?
  tag      Tag?            @relation(fields: [tagId], references: [id], onDelete: SetNull)

  epicId String
  epic   Epic   @relation(fields: [epicId], references: [id], onDelete: Cascade)

  userStories UserStory[]

  @@index([tagId])
  @@map("features")
}

model UserStory {
  id           String   @id @default(uuid())
  name         String
  description  String   @default("")
  creationDate DateTime @default(now())

  priority StoryPriority @default(LOW)
  status   StoryStatus   @default(TO_DO)
  tagId    String?
  tag      Tag?          @relation(fields: [tagId], references: [id], onDelete: SetNull)

  attachment String?

  fsdAcceptanceCriteria FsdUserStoryAcceptanceCriterion[]
  fsdBusinessRules      FsdUserStoryBusinessRule[]
  fsdIntegrations       FsdUserStoryIntegration[]

  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([tagId])
  @@map("user_stories")
}

model FsdUserStoryAcceptanceCriterion {
  id          String    @id @default(uuid())
  userStoryId String
  userStory   UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  criteriaId String
  given      String
  when       String
  then       String
  status     String    @default("open")
  order      Int       @default(0)

  @@index([userStoryId, order])
  @@map("fsd_user_story_acceptance_criteria")
}

model FsdUserStoryBusinessRule {
  id          String    @id @default(uuid())
  userStoryId String
  userStory   UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  ruleId      String
  title       String
  description String
  priority    String?
  source      String?
  order       Int       @default(0)

  @@index([userStoryId, order])
  @@map("fsd_user_story_business_rules")
}

model FsdUserStoryIntegration {
  id          String    @id @default(uuid())
  userStoryId String
  userStory   UserStory @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  action      String
  integration String
  order       Int       @default(0)

  @@index([userStoryId, order])
  @@map("fsd_user_story_integrations")
}

model Tag {
  id    String @id @default(uuid())
  label String @unique
  color String

  epics      Epic[]
  features   Feature[]
  userStories UserStory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("tags")
}

model Environment {
  id          String  @id @default(uuid())
  name        String
  url         String
  description String?
  status      String  @default("Projet")

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id])

  envItems EnvItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("environments")
}

model EnvItem {
  id String @id @default(uuid())

  environmentKey String @map("key")
  value          String

  environmentId String      @map("environment_id")
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("env_items")
}

// ENUMS

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  ARCHIVED
  COMPLETED
}

enum Platform {
  WEB
  MOBILE
}

enum StoryPriority {
  HIGH
  MEDIUM
  LOW
}

enum StoryStatus {
  TO_DO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum FeaturePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FeatureStatus {
  NEW
  COMPLETED
  IN_PROGRESS
  PENDING
}

enum EpicStatus {
  NEW
  COMPLETED
  IN_PROGRESS
  PENDING
}

enum EpicPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentVersionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETE
}
